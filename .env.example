# Copy to .env.local and fill in. Never commit real keys.

# Gemini API key used by the live investigator (https://aistudio.google.com/apikey).
# Optional: visitors can also paste their own key in the app's Settings dialog.
GEMINI_API_KEY=

# Model for research (Google Search grounding) and for the structured synthesis step.
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_SYNTHESIS_MODEL=gemini-4-argon

# Live investigations per IP per hour when the server's key is used (BYO-key runs are not limited).
INVESTIGATE_LIMIT_PER_HOUR=6

# Set to 1 to run the investigator against canned responses (no API calls, no tokens) — for UI/dev testing only.
INVESTIGATOR_MOCK=0
